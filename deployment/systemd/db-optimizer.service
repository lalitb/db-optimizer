[Unit]
Description=DB Optimizer Agent - Autonomous PostgreSQL Co-Pilot
Documentation=https://github.com/lalitb/db-optimizer
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=db-optimizer
Group=db-optimizer
WorkingDirectory=/opt/db-optimizer

# Main executable
ExecStart=/usr/local/bin/db-optimizer agent --config /etc/db-optimizer/config.yml

# Restart policy
Restart=always
RestartSec=10s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=db-optimizer

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/db-optimizer /var/log/db-optimizer

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

# Environment (override with /etc/db-optimizer/environment)
EnvironmentFile=-/etc/db-optimizer/environment

[Install]
WantedBy=multi-user.target
